# Spoke-Agent — ENV-Vorlage.
# Pfad fuer Produktiv-Deploy: /etc/spoke-agent/env (chmod 600)

# --- Identitaet --------------------------------------------------------------
# Frei waehlbarer Name fuer diesen Spoke; sollte zum Hostnamen passen.
SPOKE_NAME=nuc
# Komma-getrennt; Beispiel: "gpu,rtx5070ti,linux"
SPOKE_TAGS=gpu,linux
# Optional: explizite App-ID zur Referenzierung im Router
APP_ID=

# --- Router-Anbindung -------------------------------------------------------
ROUTER_URL=http://100.99.159.80:8080
# Fallback wenn primary 3x in Folge nicht erreichbar (z.B. Tailscale-down)
FALLBACK_ROUTER_URL=
# API-Key fuer outbound-Calls an den Router (Bearer-Auth)
API_KEY=
# Auth-Header fuer den Register-POST (vom Router-Admin gesetzt)
SPOKE_REGISTRATION_TOKEN=

# --- Lokale Discovery -------------------------------------------------------
# Wo liegt das Spoke-Stack-Compose-File (auf dem Host-FS)?
DOCKER_COMPOSE_PATH=/etc/spoke-stack/compose.yaml

# --- Admin-UI ---------------------------------------------------------------
# Empfohlen: starkes Passwort, kein Default
SPOKE_AGENT_ADMIN_PASSWORD=CHANGEME-vault
# Auth komplett ausschalten (NUR fuer Tailscale-only Setups!)
# SPOKE_AGENT_AUTH=off

# Bind. Im Spoke-Stack Compose wird das Port-Binding gemacht.
SPOKE_AGENT_BIND=0.0.0.0
SPOKE_AGENT_PORT=7844

# --- Verhalten --------------------------------------------------------------
SPOKE_REGISTER_INTERVAL_S=30
SPOKE_DISCOVERY_INTERVAL_S=15
SPOKE_MAX_BACKOFF_S=60
